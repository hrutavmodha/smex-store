{
  "name": "smex-store",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./client\" --filter \"./server\" dev",
    "build": "pnpm --filter \"./client\" --filter \"./server\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "clean": "pnpm --recursive exec rm -rf node_modules dist .next .turbo",
    "cloc": "./scripts/cloc.js",
    "commit": "./scripts/stage-commit-push.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
