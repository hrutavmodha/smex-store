{
  "type": "module",
  "name": "@smex/server",
  "private": true,
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "fastify start -l info dist/app.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "watch": "tsdown -w",
    "dev": "fastify start -w -l info src/app.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --loader ts-node/esm src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.0",
    "@fastify/websocket": "^11.3.3",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "concurrently": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}