{
  "type": "module",
  "name": "@smex/server",
  "private": true,
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "tsdown && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "fastify start -l info dist/app.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown -w",
    "dev": "fastify start -w -l info src/app.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "c8": "^12.0.0",
    "concurrently": "^10.0.1",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.2"
  }
}