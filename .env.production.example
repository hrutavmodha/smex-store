# Smex Store - Production Environment Variables Template
# Copy to .env or configure in deployment environment on production hosts

# Runtime Environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database Configuration
POSTGRES_PASSWORD=replace_with_strong_postgres_password
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/smex_store

# Redis Cache & Sessions
REDIS_URL=redis://redis:6379

# Cryptographic & Authentication Secrets
# Production deployments MUST supply secure non-development secrets >= 32 characters
JWT_SECRET=replace_with_a_secure_production_jwt_secret_32_chars_min!
JWT_REFRESH_SECRET=replace_with_a_secure_production_jwt_refresh_secret_32_chars!

# Domain Ingress & CORS
CORS_ORIGIN=https://smexstore.com
CLIENT_URL=https://smexstore.com
COOKIE_SECURE=true

# MinIO / S3 Object Storage
MINIO_ROOT_USER=replace_with_production_minio_admin_user
MINIO_ROOT_PASSWORD=replace_with_strong_minio_admin_password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://smexstore.com
S3_REGION=auto
S3_BUCKET=smex-storage
S3_ACCESS_KEY_ID=replace_with_production_minio_admin_user
S3_SECRET_ACCESS_KEY=replace_with_strong_minio_admin_password

# Client Build-Time Configuration
# Leave blank to use same-origin relative API (/api/...) and WebSocket (window.location.host)
PROD_PUBLIC_API_URL=
PROD_PUBLIC_WS_URL=

# Continuous Deployment Image Tags (GHCR)
SERVER_IMAGE=ghcr.io/smex-store/server:latest
CLIENT_IMAGE=ghcr.io/smex-store/client:latest

# Third-Party Integrations (Optional)
RESEND_API_KEY=
